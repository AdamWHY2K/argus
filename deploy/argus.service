[Unit]
Description=argus — watches web pages and reports what changed
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/proj/argus/server
ExecStart=/usr/bin/node src/index.ts
Restart=always
RestartSec=5
# A notification CLI in ~/.local/bin would not be on a user unit's default PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=ARGUS_PORT=8797
# The URL you reach argus on — notification links are built from it.
Environment=ARGUS_BASE_URL=http://localhost:8797
EnvironmentFile=-%h/proj/argus/argus.env

[Install]
WantedBy=default.target
