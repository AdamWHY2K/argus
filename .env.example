# argus configuration. Nothing here is required — argus runs with none of it set,
# and every notification value can also be entered in the UI at /settings.
# Copy to .env and edit what you need.

# ── core ──────────────────────────────────────────────────────────────────────
# How you reach argus. Notification links are built from this, so localhost is
# wrong the moment you open argus from another machine.
ARGUS_BASE_URL=http://localhost:8797
#ARGUS_PORT=8797

# Where the database and snapshots live. Set to /data inside the container.
#ARGUS_DATA=/data

# System browser to drive. The Docker image sets this to /usr/bin/chromium.
#ARGUS_CHROME=/usr/bin/google-chrome-stable

# Attach to an already-running Chrome over CDP instead of launching one —
# the way to watch pages that sit behind a login.
#ARGUS_CDP=http://127.0.0.1:9222

# ── pacing ────────────────────────────────────────────────────────────────────
#ARGUS_CONCURRENCY=3
#ARGUS_HOST_GAP_MS=5000
#ARGUS_FETCH_TIMEOUT_MS=30000
#ARGUS_VIEWPORT_W=1440
#ARGUS_VIEWPORT_H=900

# ── retention (snapshots are the only thing that grows without bound) ─────────
#ARGUS_RETAIN_UNCHANGED=5
#ARGUS_RETAIN_CHANGED=100
#ARGUS_WATCH_BYTE_CAP=209715200

# ── email ─────────────────────────────────────────────────────────────────────
# Any SMTP relay. ARGUS_SMTP_SECURE=1 for implicit TLS (port 465); leave 0 for
# STARTTLS (port 587).
#ARGUS_SMTP_HOST=smtp.example.com
#ARGUS_SMTP_PORT=587
#ARGUS_SMTP_SECURE=0
#ARGUS_SMTP_USER=argus@example.com
#ARGUS_SMTP_PASS=
#ARGUS_EMAIL_FROM=argus@example.com
#ARGUS_EMAIL_TO=you@example.com

# ── webhook ───────────────────────────────────────────────────────────────────
#ARGUS_WEBHOOK_URL=https://example.com/hooks/argus

# ── local command ─────────────────────────────────────────────────────────────
# Runs a notification CLI on the host: <bin> <args> [--stream S] [--file PNG] <message>.
# Off unless you have one.
#ARGUS_COMMAND_ENABLED=1
#ARGUS_COMMAND_BIN=notify-send
#ARGUS_COMMAND_ARGS=argus

# ── docker only ───────────────────────────────────────────────────────────────
# Host port to publish on, if 8797 is already taken.
#ARGUS_HOST_PORT=8797
